DEBUG=True
SECRET_KEY=django-insecure-supabase-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================================
# Supabase PostgreSQL Database Configuration
# ========================================================
# Option 1: Direct Connection URI or Connection Pooler (Recommended)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option 2: Individual parameters
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_SSLMODE=require

# ========================================================
# Offline / Local fallback (Optional)
# ========================================================
# USE_SQLITE=False
