# ========================================================
# Production & Render Environment Variables
# ========================================================
DEBUG=False
SECRET_KEY=django-secure-random-key-generate-one-for-production
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ========================================================
# CORS & CSRF (Set your Vercel frontend URL here)
# ========================================================
CORS_ALLOWED_ORIGINS=https://student-resource-hub.vercel.app
CSRF_TRUSTED_ORIGINS=https://student-resource-hub.vercel.app,https://student-resource-hub-backend.onrender.com

# ========================================================
# Supabase PostgreSQL Database Configuration
# ========================================================
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ========================================================
# Email Verification & Contact Delivery (Gmail SMTP)
# ========================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=eyobbegashaw075@gmail.com
# Google Account -> Security -> 2-Step Verification -> App Passwords (16 characters)
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=StudentHub <eyobbegashaw075@gmail.com>

# ========================================================
# Optional: AWS S3 (Leave false to use built-in Whitenoise)
# ========================================================
USE_S3=False
